{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::<S3_BUCKET>",
        "arn:aws:s3:::<S3_BUCKET>/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "EllucianListLatest",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::<ELLUCIAN_ACCOUNT_ID>:root" },
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<S3_BUCKET>",
      "Condition": { "StringLike": { "s3:prefix": ["scripts/latest/*"] } }
    },
    {
      "Sid": "EllucianReadLatest",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::<ELLUCIAN_ACCOUNT_ID>:root" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<S3_BUCKET>/scripts/latest/*"
    }
  ]
}
